#!/usr/bin/env bash
action="$1"
shift

# Unir el resto de argumentos por si tienen espacios y limpiar
assignment="$*"

case "$action" in
    dfcr|create|define)
        # Limpiar comillas iniciales o espacios extra si los hubiera
        if [[ "$assignment" =~ ^([a-zA-Z0-9_]+)=(.*)$ ]]; then
            var_name="${BASH_REMATCH[1]}"
            var_val="${BASH_REMATCH[2]}"
            
            # Quitar comillas envolventes del valor si existen
            var_val=$(echo "$var_val" | sed -E 's/^[[:space:]]*["\']?(.*)["\']?[[:space:]]*$/\1/')
            
            # Expandir variables !{var} si se usan dentro del valor
            expanded_val=$(echo "$var_val" | sed -E 's/!\{([a-zA-Z0-9_]+)\}/${\1}/g')
            final_val=$(eval echo "$expanded_val")
            
            if [ -n "$BANANA_ENV_FILE" ]; then
                echo "export $var_name=\"$final_val\"" >> "$BANANA_ENV_FILE"
            fi
            export "$var_name"="$final_val"
        else
            echo "[Banana Error] Sintaxis de variable inválida. Usa: var dfcr nombre=\"valor\"" >&2
            exit 1
        fi
        ;;
    del)
        var_name="$1"
        unset "$var_name"
        if [ -n "$BANANA_ENV_FILE" ]; then
            sed -i "/export $var_name=/d" "$BANANA_ENV_FILE"
        fi
        ;;
    *)
        echo "[Banana Error] Acción de variable desconocida: $action" >&2
        exit 1
        ;;
esac
