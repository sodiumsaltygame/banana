#!/usr/bin/env bash
flag=""
content="$*"

if [[ "$1" == "-ve" ]]; then
    flag="-ve"
    shift
    content="$*"
fi

clean_content=$(echo "$content" | sed -E 's/^\((.*)\)$/\1/' | sed -E 's/^"(.*)"$/\1/')

if [ "$flag" = "-ve" ]; then
    eval "echo \"$clean_content\"" | sed -E 's/!\{([a-zA-Z0-9_]+)\}/${\1}/g' | xargs echo
else
    echo "$clean_content"
fi
